# ===== Database (Supabase) =====
# ถ้าเพิ่ม Supabase ผ่านแท็บ Storage ของ Vercel ระบบจะสร้าง POSTGRES_PRISMA_URL
# และ POSTGRES_URL_NON_POOLING ให้อัตโนมัติ ไม่ต้องใส่ 2 ตัวนี้
# Pooled connection (port 6543) — ใช้ตอนแอปรัน
DATABASE_URL=""
# Direct connection (port 5432) — ใช้ตอนสร้าง/แก้ตาราง
DIRECT_URL=""

# ===== LINE Messaging API =====
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# ===== Options =====
# true = ใส่ข้อมูลตัวอย่างตอน deploy (รันซ้ำได้ ไม่สร้างซ้ำ)
SEED_DEMO="false"
