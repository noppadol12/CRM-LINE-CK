// =============================================================
//  CK CRM — Database schema
//  Customers · Tags · Chat logs (LINE) · Admin notes · Deals · Quick replies
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin users (ทีมเซลส์ / แอดมิน) ----------

enum AdminRole {
  OWNER
  ADMIN
  SALES
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         AdminRole @default(SALES)
  isActive     Boolean   @default(true)
  // เพิ่มทุกครั้งที่เปลี่ยน/รีเซ็ตรหัสผ่าน หรือปิดบัญชี → session เก่าทุกเครื่องใช้ไม่ได้ทันที
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false) // รหัสชั่วคราวที่หัวหน้าตั้งให้
  lastLoginAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedCustomers Customer[]    @relation("CustomerAssignee")
  notes             AdminNote[]
  sentMessages      ChatMessage[]
  ownedDeals        Deal[]        @relation("DealOwner")
  dealEvents        DealEvent[]
  pushSubscriptions PushSubscription[]
  shipments         Shipment[]

  @@map("admin_users")
}

// ---------- Customers ----------

enum FollowStatus {
  FOLLOWING // เพิ่มเพื่อน OA อยู่
  UNFOLLOWED // บล็อก / เลิกติดตาม
  UNKNOWN // เพิ่มเองจากหลังบ้าน ยังไม่ผูก LINE
}

model Customer {
  id              String    @id @default(cuid())
  lineUserId      String?   @unique // LINE UID (U…) หรือ Group ID (C…) / Room ID (R…) — null ได้ถ้าเพิ่มลูกค้าเอง
  chatType        String    @default("user") // user = แชท 1:1 · group = กลุ่ม LINE · room = แชทหลายคน
  lineName        String? // displayName จากโปรไฟล์ LINE
  pictureUrl      String?
  statusMessage   String?
  profileSyncedAt DateTime? // ดึงชื่อ/รูปจาก LINE ล่าสุดเมื่อไหร่

  fullName String? // ชื่อจริงที่แอดมินกรอก
  phone    String?
  email    String?
  company  String?
  address  String?

  followStatus FollowStatus @default(UNKNOWN)
  followedAt   DateTime?
  unfollowedAt DateTime?

  // สำหรับหน้า Inbox
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)

  // reply token จากข้อความล่าสุด — ตอบด้วย Reply API ได้ฟรี (ไม่นับโควตา) ถ้าตอบทันภายในเวลาสั้น ๆ
  lastReplyToken   String?
  lastReplyTokenAt DateTime?

  assignedToId String?
  assignedTo   AdminUser? @relation("CustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // การจัดส่ง
  province        String? // ชื่อจังหวัด (ดู src/lib/provinces.ts)
  carrierId       String? // ขนส่งหลัก
  backupCarrierId String? // ขนส่งสำรอง
  shippingNote    String? // เช่น รับที่ท่ารถหาดใหญ่ โทรแจ้งก่อนส่ง
  carrier         Carrier? @relation("PrimaryCarrier", fields: [carrierId], references: [id], onDelete: SetNull)
  backupCarrier   Carrier? @relation("BackupCarrier", fields: [backupCarrierId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — ไม่ลบประวัติแชท/ดีลทิ้ง

  tags      CustomerTag[]
  messages  ChatMessage[]
  notes     AdminNote[]
  deals     Deal[]
  shipments Shipment[]

  @@index([phone])
  @@index([province])
  @@index([carrierId])
  @@index([lastMessageAt(sort: Desc)])
  @@index([deletedAt])
  @@map("customers")
}

// ---------- Tags ----------

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("slate") // ชื่อสี Tailwind เช่น emerald, amber, sky
  createdAt DateTime @default(now())

  customers CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String
  tagId      String
  assignedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

// ---------- Chat logs ----------

enum MessageDirection {
  INBOUND // ลูกค้า → OA
  OUTBOUND // แอดมิน → ลูกค้า
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  LOCATION
  OTHER
}

model ChatMessage {
  id         String           @id @default(cuid())
  customerId String
  direction  MessageDirection
  type       MessageType      @default(TEXT)
  text       String?
  mediaUrl   String? // (สำรอง) ลิงก์ไฟล์ภายนอก

  // สำเนาไฟล์ใน Google Drive (LINE เก็บไฟล์ไว้ชั่วคราวเท่านั้น)
  driveFileId   String?
  mediaMime     String?
  mediaSize     Int?
  mediaAttempts Int       @default(0)
  mediaError    String?
  mediaSavedAt  DateTime?
  payload    Json? // message object ดิบจาก LINE (sticker id, location ฯลฯ)

  lineMessageId String? @unique // กันข้อความซ้ำเมื่อ LINE retry
  sentById      String? // แอดมินที่ส่ง (OUTBOUND)
  sentVia       String? // reply (ฟรี) | push (นับโควตา)

  // แชทกลุ่ม: ใครในกลุ่มเป็นคนส่ง
  senderLineId     String?
  senderName       String?
  senderPictureUrl String?

  sentAt DateTime  @default(now())
  readAt DateTime?

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sentBy   AdminUser? @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([customerId, sentAt])
  @@index([type, driveFileId])
  @@map("chat_messages")
}

// ---------- Internal admin notes (ลูกค้ามองไม่เห็น) ----------

model AdminNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?
  body       String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("admin_notes")
}

// ---------- Deals / ใบเสนอราคา (Sales pipeline) ----------

/**
 * ขั้นของดีล — เพิ่ม/แก้ชื่อ/สี/ลำดับได้เองที่หน้าตั้งค่า
 * id "WON" (ปิดการขาย) และ "LOST" (ไม่ซื้อ) เป็นขั้นของระบบ ลบไม่ได้ (รายงานใช้คำนวณยอดขาย/อัตราปิด)
 * ขั้นเริ่มต้นใช้ id เดิม: INQUIRY, QUOTED, AWAITING_PAYMENT, SHIPPING
 */
model DealStageDef {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("slate") // ชื่อสีเดียวกับแท็ก
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deals Deal[]

  @@map("deal_stages")
}

model Deal {
  id                String    @id @default(cuid())
  customerId        String
  title             String
  items             String? // สินค้า / รุ่น / จำนวนที่ลูกค้าสนใจ
  amount            Decimal?  @db.Decimal(12, 2) // มูลค่าดีล (บาท)
  stage             String // id ของ deal_stages
  quoteNo           String? // เลขที่ใบเสนอราคา
  nextFollowUpAt    DateTime? // วันนัดติดตาม
  expectedCloseDate DateTime?
  lostReason        String?
  ownerId           String?
  stageChangedAt    DateTime  @default(now())
  closedAt          DateTime? // เวลาที่เข้า WON / LOST
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner    AdminUser?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageDef  DealStageDef @relation(fields: [stage], references: [id], onDelete: Restrict)
  events    DealEvent[]
  shipments Shipment[]

  @@index([stage, updatedAt])
  @@index([customerId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@map("deals")
}

/**
 * ประวัติดีล — ใช้ดูย้อนหลังและทำรายงานอัตราปิดการขาย
 */
model DealEvent {
  id        String     @id @default(cuid())
  dealId    String
  type      String // created | stage | updated
  fromStage String? // id ของขั้น (เก็บไว้แม้ขั้นถูกลบภายหลัง)
  toStage   String?
  note      String?
  actorId   String?
  createdAt DateTime   @default(now())

  deal  Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@map("deal_events")
}

// ---------- ข้อความสำเร็จรูป ----------

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("quick_replies")
}

// ---------- Raw LINE webhook log ----------

model WebhookEvent {
  id          String    @id // webhookEventId จาก LINE (กันประมวลผลซ้ำ)
  type        String
  lineUserId  String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?
  attempts    Int       @default(1)

  @@index([receivedAt])
  @@map("webhook_events")
}

// ---------- ค่าตั้งระบบ (เช่น การเชื่อมต่อ Google Drive) ----------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------- กันเดารหัสผ่าน ----------

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ---------- แจ้งเตือนบนมือถือ/คอมพิวเตอร์ (Web Push) ----------

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------- ขนส่ง ----------

model Carrier {
  id             String   @id @default(cuid())
  name           String
  kind           String   @default("freight") // parcel พัสดุด่วน · freight ขนส่งต่างจังหวัด/รถร่วม · post ไปรษณีย์ · ondemand รถเรียก
  phone          String?
  lineId         String?
  dropoffAddress String? // จุดส่งของฝั่งร้าน (ท่ารถ/สาขาในกรุงเทพ)
  mapUrl         String?
  cutoffTime     String? // เวลาปิดรับของ เช่น 16:00
  payment        String? // origin ต้นทาง · destination ปลายทาง · both ได้ทั้งสองแบบ
  priceNote      String?
  trackingUrl    String? // ลิงก์ติดตามพัสดุ ใส่ {เลขพัสดุ} แทนเลข
  note           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coverage         CarrierCoverage[]
  primaryCustomers Customer[]        @relation("PrimaryCarrier")
  backupCustomers  Customer[]        @relation("BackupCarrier")
  shipments        Shipment[]

  @@map("carriers")
}

/** ขนส่งเจ้านี้ไปจังหวัดไหน + ข้อมูลสาขาปลายทาง */
model CarrierCoverage {
  carrierId   String
  province    String
  branch      String? // สาขา/ท่ารถปลายทาง
  phone       String?
  transitDays String? // เช่น 1-2 วัน
  note        String?
  createdAt   DateTime @default(now())

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@id([carrierId, province])
  @@index([province])
  @@map("carrier_coverage")
}

/** บันทึกการส่งของแต่ละครั้ง */
model Shipment {
  id          String    @id @default(cuid())
  customerId  String
  dealId      String?
  carrierId   String?
  trackingNo  String?
  cost        Decimal?  @db.Decimal(10, 2) // ค่าส่ง (บาท)
  boxes       Int?
  shippedAt   DateTime  @default(now())
  note        String?
  notifiedAt  DateTime? // ส่งเลขพัสดุให้ลูกค้าทาง LINE แล้ว
  createdById String?
  createdAt   DateTime  @default(now())

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal      Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  carrier   Carrier?   @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId, shippedAt])
  @@index([carrierId, shippedAt])
  @@index([shippedAt])
  @@map("shipments")
}
