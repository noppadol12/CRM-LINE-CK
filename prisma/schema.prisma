// =============================================================
//  CK CRM — Database schema
//  Customers · Tags · Chat logs (LINE) · Admin notes · Deals · Quick replies
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin users (ทีมเซลส์ / แอดมิน) ----------

enum AdminRole {
  OWNER
  ADMIN
  SALES
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         AdminRole @default(SALES)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedCustomers Customer[]    @relation("CustomerAssignee")
  notes             AdminNote[]
  sentMessages      ChatMessage[]
  ownedDeals        Deal[]        @relation("DealOwner")
  dealEvents        DealEvent[]

  @@map("admin_users")
}

// ---------- Customers ----------

enum FollowStatus {
  FOLLOWING // เพิ่มเพื่อน OA อยู่
  UNFOLLOWED // บล็อก / เลิกติดตาม
  UNKNOWN // เพิ่มเองจากหลังบ้าน ยังไม่ผูก LINE
}

model Customer {
  id              String    @id @default(cuid())
  lineUserId      String?   @unique // LINE UID (U + 32 hex) — null ได้ถ้าเพิ่มลูกค้าเอง
  lineName        String? // displayName จากโปรไฟล์ LINE
  pictureUrl      String?
  statusMessage   String?
  profileSyncedAt DateTime? // ดึงชื่อ/รูปจาก LINE ล่าสุดเมื่อไหร่

  fullName String? // ชื่อจริงที่แอดมินกรอก
  phone    String?
  email    String?
  company  String?
  address  String?

  followStatus FollowStatus @default(UNKNOWN)
  followedAt   DateTime?
  unfollowedAt DateTime?

  // สำหรับหน้า Inbox
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)

  assignedToId String?
  assignedTo   AdminUser? @relation("CustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — ไม่ลบประวัติแชท/แต้มทิ้ง

  tags     CustomerTag[]
  messages ChatMessage[]
  notes    AdminNote[]
  deals    Deal[]

  @@index([phone])
  @@index([lastMessageAt(sort: Desc)])
  @@index([deletedAt])
  @@map("customers")
}

// ---------- Tags ----------

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("slate") // ชื่อสี Tailwind เช่น emerald, amber, sky
  createdAt DateTime @default(now())

  customers CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  customerId String
  tagId      String
  assignedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

// ---------- Chat logs ----------

enum MessageDirection {
  INBOUND // ลูกค้า → OA
  OUTBOUND // แอดมิน → ลูกค้า
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  STICKER
  LOCATION
  OTHER
}

model ChatMessage {
  id         String           @id @default(cuid())
  customerId String
  direction  MessageDirection
  type       MessageType      @default(TEXT)
  text       String?
  mediaUrl   String? // ไฟล์ที่เราเก็บเอง (LINE ไม่เก็บถาวร)
  payload    Json? // message object ดิบจาก LINE (sticker id, location ฯลฯ)

  lineMessageId String? @unique // กันข้อความซ้ำเมื่อ LINE retry
  sentById      String? // แอดมินที่ส่ง (OUTBOUND)

  sentAt DateTime  @default(now())
  readAt DateTime?

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sentBy   AdminUser? @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([customerId, sentAt])
  @@map("chat_messages")
}

// ---------- Internal admin notes (ลูกค้ามองไม่เห็น) ----------

model AdminNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?
  body       String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("admin_notes")
}

// ---------- Deals / ใบเสนอราคา (Sales pipeline) ----------

enum DealStage {
  INQUIRY // สอบถาม
  QUOTED // เสนอราคาแล้ว
  AWAITING_PAYMENT // รอโอนเงิน
  SHIPPING // เตรียม/จัดส่ง
  WON // ปิดการขาย
  LOST // ไม่ซื้อ
}

model Deal {
  id                String    @id @default(cuid())
  customerId        String
  title             String
  items             String? // สินค้า / รุ่น / จำนวนที่ลูกค้าสนใจ
  amount            Decimal?  @db.Decimal(12, 2) // มูลค่าดีล (บาท)
  stage             DealStage @default(INQUIRY)
  quoteNo           String? // เลขที่ใบเสนอราคา
  nextFollowUpAt    DateTime? // วันนัดติดตาม
  expectedCloseDate DateTime?
  lostReason        String?
  ownerId           String?
  stageChangedAt    DateTime  @default(now())
  closedAt          DateTime? // เวลาที่เข้า WON / LOST
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner    AdminUser?  @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events   DealEvent[]

  @@index([stage, updatedAt])
  @@index([customerId])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@map("deals")
}

/**
 * ประวัติดีล — ใช้ดูย้อนหลังและทำรายงานอัตราปิดการขาย
 */
model DealEvent {
  id        String     @id @default(cuid())
  dealId    String
  type      String // created | stage | updated
  fromStage DealStage?
  toStage   DealStage?
  note      String?
  actorId   String?
  createdAt DateTime   @default(now())

  deal  Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@map("deal_events")
}

// ---------- ข้อความสำเร็จรูป ----------

model QuickReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("quick_replies")
}

// ---------- Raw LINE webhook log ----------

model WebhookEvent {
  id          String    @id // webhookEventId จาก LINE (กันประมวลผลซ้ำ)
  type        String
  lineUserId  String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([receivedAt])
  @@map("webhook_events")
}
